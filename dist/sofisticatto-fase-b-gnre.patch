+++ b/tests/unit/correios.test.js
@@ -0,0 +1,139 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+
+const { preserveEnv, resetEnv, restoreEnv, setEnv } = require('../helpers/env');
+const { response, withFetch } = require('../helpers/http');
+const { loadScript } = require('../helpers/sandbox');
+
+preserveEnv();
+const correios = require('../../lib/integracoes/_correios');
+const fixture = require('../fixtures/correios-prepostagens.json');
+const sandbox = loadScript('lib/integracoes/_correios.js');
+const { context: interno } = sandbox;
+
+test.beforeEach(() => resetEnv());
+test.after(() => restoreEnv());
+
+test('cfg exige usuário e código de acesso', () => {
+  assert.throws(() => correios.cfg(), /CORREIOS_USUARIO/);
+  setEnv({ CORREIOS_USUARIO: 'usuario-ficticio', CORREIOS_CODIGO_ACESSO: 'codigo-ficticio' });
+  const c = correios.cfg();
+  assert.equal(c.usuario, 'usuario-ficticio');
+  assert.equal(c.codigo, 'codigo-ficticio');
+  assert.equal(c.cnpj.length, 14);
+  assert.deepEqual(c.servicos, []);
+});
+
+test('listaPrepostResposta reconhece os envelopes usados pela API', () => {
+  assert.deepEqual(correios.listaPrepostResposta([1, 2]), [1, 2]);
+  assert.deepEqual(correios.listaPrepostResposta({ itens: [1] }), [1]);
+  assert.deepEqual(correios.listaPrepostResposta({ items: [2] }), [2]);
+  assert.deepEqual(correios.listaPrepostResposta({ content: [3] }), [3]);
+  assert.deepEqual(correios.listaPrepostResposta({ prePostagens: [4] }), [4]);
+  assert.deepEqual(correios.listaPrepostResposta({ objetos: [5] }), [5]);
+  assert.deepEqual(correios.listaPrepostResposta({ outro: [6] }), []);
+});
+
+test('valorProfundo procura a primeira chave preenchida em qualquer nível', () => {
+  const item = { a: { cpfCnpj: '11222333000181' }, b: { cpfCnpj: '99999999000199' } };
+  assert.equal(correios.valorProfundo(item, ['cpfCnpj']), '11222333000181');
+  assert.equal(correios.valorProfundo(item, ['inexistente']), '');
+  assert.equal(correios.valorProfundo(null, ['x']), '');
+});
+
+test('expToken usa 50 minutos por padrão e respeita expiraEm', () => {
+  const agora = Date.now();
+  const padrao = interno.expToken({});
+  assert.ok(padrao >= agora + 49 * 60 * 1000 && padrao <= agora + 51 * 60 * 1000);
+  const exato = interno.expToken({ expiraEm: '2030-01-01T00:00:00.000Z' });
+  assert.equal(exato, Date.parse('2030-01-01T00:00:00.000Z'));
+});
+
+test('br interpreta decimal brasileiro e n normaliza entrada', () => {
+  assert.equal(interno.br('1.234,56'), 1234.56);
+  assert.equal(interno.br('10,5'), 10.5);
+  assert.equal(interno.br(''), 0);
+  assert.equal(interno.n('10,5'), '10.5');
+});
+
+test('servicoCotavel aceita apenas produtos de contrato AG', () => {
+  assert.equal(interno.servicoCotavel({ codigo: '03298', descricao: 'PAC CONTRATO AG' }), true);
+  assert.equal(interno.servicoCotavel({ codigo: '03220', descricao: 'SEDEX CONTRATO AG' }), true);
+  assert.equal(interno.servicoCotavel({ codigo: '03298', descricao: 'LOGISTICA REVERSA' }), false);
+  assert.equal(interno.servicoCotavel({ codigo: '123', descricao: 'PAC' }), false);
+});
+
+function mockCorreios(payload) {
+  return async (url) => {
+    if (url.includes('/token/v1/autentica')) {
+      return response({ token: 'token-ficticio', expiraEm: '2030-01-01T00:00:00.000Z' });
+    }
+    if (url.includes('/prepostagem/')) {
+      const status = new URL(url).searchParams.get('status');
+      return response(status === 'POSTADO' ? payload : { itens: [] });
+    }
+    return undefined;
+  };
+}
+
+test('descobrirCodigoObjeto encontra o objeto por CNPJ e CEP', async () => {
+  setEnv({ CORREIOS_USUARIO: 'usuario-ficticio', CORREIOS_CODIGO_ACESSO: 'codigo-ficticio' });
+  let resultado = null;
+  await withFetch(mockCorreios(fixture), async () => {
+    resultado = await correios.descobrirCodigoObjeto({
+      cnpj: '11222333000181',
+      cep: '74000000',
+      nome: 'CLIENTE FICTICIO ALFA',
+      data: '2026-01-10T10:00:00'
+    });
+  });
+  assert.equal(resultado.codigo, 'AA123456789BR');
+  assert.ok(resultado.score >= 150);
+});
+
+test('descobrirCodigoObjeto não vincula quando há empate de pontuação', async () => {
+  setEnv({ CORREIOS_USUARIO: 'usuario-ficticio', CORREIOS_CODIGO_ACESSO: 'codigo-ficticio' });
+  const item = fixture.itens[0];
+  const empate = {
+    itens: [
+      { ...item, codigoObjeto: 'CC111111111BR' },
+      { ...item, codigoObjeto: 'DD222222222BR' }
+    ]
+  };
+  let resultado = null;
+  await withFetch(mockCorreios(empate), async () => {
+    resultado = await correios.descobrirCodigoObjeto({
+      cnpj: '11222333000181',
+      cep: '74000000',
+      nome: 'CLIENTE FICTICIO ALFA'
+    });
+  });
+  assert.equal(resultado.codigo, null);
+  assert.match(resultado.motivo, /Mais de um objeto/);
+});
+
+test('descobrirCodigoObjeto não aceita correspondência fraca', async () => {
+  setEnv({ CORREIOS_USUARIO: 'usuario-ficticio', CORREIOS_CODIGO_ACESSO: 'codigo-ficticio' });
+  let resultado = null;
+  await withFetch(mockCorreios({ itens: [fixture.itens[1]] }), async () => {
+    resultado = await correios.descobrirCodigoObjeto({
+      cnpj: '11222333000181',
+      cep: '74000000',
+      nome: 'CLIENTE FICTICIO ALFA'
+    });
+  });
+  assert.equal(resultado.codigo, null);
+  assert.match(resultado.motivo, /sem correspondência segura/);
+});
+
+test('descobrirCodigoObjeto informa quando não há pré-postagens', async () => {
+  setEnv({ CORREIOS_USUARIO: 'usuario-ficticio', CORREIOS_CODIGO_ACESSO: 'codigo-ficticio' });
+  let resultado = null;
+  await withFetch(mockCorreios({ itens: [] }), async () => {
+    resultado = await correios.descobrirCodigoObjeto({ cnpj: '11222333000181', cep: '74000000' });
+  });
+  assert.equal(resultado.codigo, null);
+  assert.match(resultado.motivo, /Nenhuma pré-postagem/);
+});
diff --git a/tests/unit/credentials.test.js b/tests/unit/credentials.test.js
new file mode 100644
index 0000000..8b4e7ce
--- /dev/null
+++ b/tests/unit/credentials.test.js
@@ -0,0 +1,212 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+
+const { preserveEnv, resetEnv, restoreEnv, setEnv } = require('../helpers/env');
+const { response, withFetch } = require('../helpers/http');
+const { fakeResponse, fakeRequest } = require('../helpers/module-stubs');
+
+preserveEnv();
+const utils = require('../../lib/integracoes/_utils');
+const { obterCredenciaisIntegracao } = require('../../lib/integracoes/carregar-credenciais');
+const salvarCredenciais = require('../../lib/integracoes/salvar-credenciais');
+const statusCredenciais = require('../../lib/integracoes/status-credenciais');
+
+const ADMIN = { 'x-integrations-admin-key': 'admin-ficticio' };
+
+function baseEnv() {
+  setEnv({
+    SUPABASE_URL: 'https://fake.supabase.test',
+    SUPABASE_SERVICE_ROLE_KEY: 'service-ficticia',
+    INTEGRATIONS_ENCRYPTION_KEY: 'e'.repeat(40),
+    INTEGRATIONS_ADMIN_KEY: 'admin-ficticio'
+  });
+}
+
+function encrypted(payload) {
+  const c = utils.criptografar(payload);
+  return { payload_criptografado: c.payload, iv: c.iv, auth_tag: c.tag };
+}
+
+test.beforeEach(() => resetEnv());
+test.after(() => restoreEnv());
+
+test('obterCredenciaisIntegracao exige convite_id', async () => {
+  baseEnv();
+  await assert.rejects(() => obterCredenciaisIntegracao(''), /convite_id/);
+});
+
+test('obterCredenciaisIntegracao descriptografa a linha do convite', async () => {
+  baseEnv();
+  const row = { convite_id: 'c1', ambiente: 'homologacao', ...encrypted({ username: 'u-ficticio', password: 'p-ficticia' }) };
+  let url = null;
+  await withFetch(async (u) => { url = u; return response([row]); }, async () => {
+    const cred = await obterCredenciaisIntegracao('c1', 'homologacao');
+    assert.deepEqual(cred, { username: 'u-ficticio', password: 'p-ficticia' });
+  });
+  assert.match(url, /convite_id=eq\.c1/);
+  assert.match(url, /ambiente=eq\.homologacao/);
+});
+
+test('obterCredenciaisIntegracao falha quando não há credencial cadastrada', async () => {
+  baseEnv();
+  await withFetch(async () => response([]), async () => {
+    await assert.rejects(() => obterCredenciaisIntegracao('c-sem-credencial'), /não cadastradas/);
+  });
+});
+
+test('salvar-credenciais rejeita método diferente de POST', async () => {
+  baseEnv();
+  const res = fakeResponse();
+  await salvarCredenciais(fakeRequest({ method: 'GET', headers: ADMIN }), res);
+  assert.equal(res.statusCode, 405);
+});
+
+test('salvar-credenciais exige autorização administrativa', async () => {
+  baseEnv();
+  const res = fakeResponse();
+  await salvarCredenciais(fakeRequest({ body: { convite_id: 'c1', ambiente: 'homologacao' } }), res);
+  assert.equal(res.statusCode, 401);
+});
+
+test('salvar-credenciais rejeita ambiente inválido', async () => {
+  baseEnv();
+  const res = fakeResponse();
+  await salvarCredenciais(fakeRequest({
+    headers: ADMIN,
+    body: { convite_id: 'c1', ambiente: 'teste', credenciais: {} }
+  }), res);
+  assert.equal(res.statusCode, 400);
+});
+
+test('salvar-credenciais preserva campos anteriores e ignora valores vazios', async () => {
+  baseEnv();
+  const anterior = encrypted({ username: 'u-ficticio', password: 'p-ficticia' });
+  const res = fakeResponse();
+  let postBody = null;
+  let postUrl = null;
+  let postPrefer = null;
+
+  await withFetch(async (url, init) => {
+    if (init.method === 'GET') return response([{ convite_id: 'c1', ...anterior }]);
+    postBody = JSON.parse(init.body);
+    postUrl = url;
+    postPrefer = init.headers.Prefer;
+    return response([{ atualizado_em: '2026-01-01T00:00:00.000Z' }]);
+  }, async () => {
+    await salvarCredenciais(fakeRequest({
+      headers: ADMIN,
+      body: {
+        convite_id: 'c1',
+        ambiente: 'homologacao',
+        credenciais: { ssw_dominio: 'ABC', username: '   ' }
+      }
+    }), res);
+  });
+
+  assert.equal(res.statusCode, 200);
+  assert.match(postUrl, /on_conflict=convite_id,ambiente/);
+  assert.equal(postPrefer, 'return=representation,resolution=merge-duplicates');
+  const salvo = utils.descriptografar({
+    payload_criptografado: postBody.payload_criptografado,
+    iv: postBody.iv,
+    auth_tag: postBody.auth_tag
+  });
+  assert.deepEqual(salvo, {
+    username: 'u-ficticio',
+    password: 'p-ficticia',
+    ssw_dominio: 'ABC'
+  });
+});
+
+test('salvar-credenciais continua quando a credencial anterior não pode ser lida', async () => {
+  baseEnv();
+  const res = fakeResponse();
+  const originalWarn = console.warn;
+  console.warn = () => {};
+  let postBody = null;
+  try {
+    await withFetch(async (url, init) => {
+      if (init.method === 'GET') return response([{ convite_id: 'c1', payload_criptografado: 'x', iv: 'y', auth_tag: 'z' }]);
+      postBody = JSON.parse(init.body);
+      return response([{ atualizado_em: '2026-01-01T00:00:00.000Z' }]);
+    }, async () => {
+      await salvarCredenciais(fakeRequest({
+        headers: ADMIN,
+        body: { convite_id: 'c1', ambiente: 'producao', credenciais: { username: 'novo-ficticio' } }
+      }), res);
+    });
+  } finally {
+    console.warn = originalWarn;
+  }
+  assert.equal(res.statusCode, 200);
+  const salvo = utils.descriptografar({
+    payload_criptografado: postBody.payload_criptografado,
+    iv: postBody.iv,
+    auth_tag: postBody.auth_tag
+  });
+  assert.deepEqual(salvo, { username: 'novo-ficticio' });
+});
+
+test('status-credenciais exige GET', async () => {
+  baseEnv();
+  const res = fakeResponse();
+  await statusCredenciais(fakeRequest({ method: 'POST', headers: ADMIN }), res);
+  assert.equal(res.statusCode, 405);
+});
+
+test('status-credenciais exige autorização', async () => {
+  baseEnv();
+  const res = fakeResponse();
+  await statusCredenciais(fakeRequest({ method: 'GET', query: { convite_id: 'c1' } }), res);
+  assert.equal(res.statusCode, 401);
+});
+
+test('status-credenciais devolve apenas booleanos, sem o payload', async () => {
+  baseEnv();
+  const row = {
+    convite_id: 'c1',
+    ambiente: 'homologacao',
+    atualizado_em: '2026-01-01T00:00:00.000Z',
+    ...encrypted({
+      username: 'usuario-dummy-123',
+      password: 'senha-dummy-456',
+      ssw_dominio: 'ABC',
+      ssw_senha_rastreio: 'rastreio-dummy-789',
+      ssw_cnpj_rastreio: '11222333000181'
+    })
+  };
+  const res = fakeResponse();
+  await withFetch(async () => response([row]), async () => {
+    await statusCredenciais(fakeRequest({
+      method: 'GET',
+      headers: ADMIN,
+      query: { convite_id: 'c1', ambiente: 'homologacao' }
+    }), res);
+  });
+  assert.equal(res.statusCode, 200);
+  assert.equal(res.body.ok, true);
+  assert.equal(res.body.existe, true);
+  assert.equal(res.body.usuario, true);
+  assert.equal(res.body.senha_webservice, true);
+  assert.equal(res.body.ssw_dominio, true);
+  const serializado = JSON.stringify(res.body);
+  for (const valor of ['usuario-dummy-123', 'senha-dummy-456', 'rastreio-dummy-789', '11222333000181']) {
+    assert.ok(!serializado.includes(valor), `payload vazou: ${valor}`);
+  }
+});
+
+test('status-credenciais informa ausência de cadastro', async () => {
+  baseEnv();
+  const res = fakeResponse();
+  await withFetch(async () => response([]), async () => {
+    await statusCredenciais(fakeRequest({
+      method: 'GET',
+      headers: ADMIN,
+      query: { convite_id: 'inexistente' }
+    }), res);
+  });
+  assert.equal(res.statusCode, 200);
+  assert.equal(res.body.existe, false);
+});
diff --git a/tests/unit/email-auth.test.js b/tests/unit/email-auth.test.js
new file mode 100644
index 0000000..148fc0e
--- /dev/null
+++ b/tests/unit/email-auth.test.js
@@ -0,0 +1,123 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+
+const { preserveEnv, resetEnv, restoreEnv, setEnv } = require('../helpers/env');
+const { response, withFetch } = require('../helpers/http');
+const emailAuth = require('../../api/_email-auth');
+
+preserveEnv();
+
+function env() {
+  setEnv({
+    SUPABASE_URL: 'https://fake.supabase.test/',
+    SUPABASE_SERVICE_ROLE_KEY: 'service-ficticia'
+  });
+}
+
+function usuario(overrides = {}) {
+  return {
+    id: 'u-1',
+    login: 'financeiro-ficticio',
+    tipo: 'financeiro',
+    senha: 'senha-ficticia',
+    ativo: true,
+    ...overrides
+  };
+}
+
+test.beforeEach(() => resetEnv());
+test.after(() => restoreEnv());
+
+test('config remove a barra final da URL', () => {
+  env();
+  const c = emailAuth.config();
+  assert.equal(c.url, 'https://fake.supabase.test');
+  assert.equal(c.key, 'service-ficticia');
+});
+
+test('validar exige Supabase configurado', async () => {
+  await assert.rejects(
+    () => emailAuth.validar({ body: { login: 'x', senha: 'y' } }),
+    (err) => err.status === 503
+  );
+});
+
+test('validar exige login e senha', async () => {
+  env();
+  await assert.rejects(
+    () => emailAuth.validar({ body: { login: '', senha: '' } }),
+    (err) => err.status === 401 && /Confirme sua senha/.test(err.message)
+  );
+});
+
+test('validar aceita usuário ativo com papel permitido', async () => {
+  env();
+  let url = null;
+  const resultado = await withFetch(async (u) => {
+    url = u;
+    return response([usuario()]);
+  }, () => emailAuth.validar({ body: { login: 'financeiro-ficticio', senha: 'senha-ficticia' } }));
+  assert.equal(resultado.usuario.login, 'financeiro-ficticio');
+  assert.match(url, /usuarios\?login=eq\.financeiro-ficticio/);
+  assert.match(url, /select=id,login,tipo,senha,ativo/);
+});
+
+test('validar aceita papel em maiúsculas', async () => {
+  env();
+  const resultado = await withFetch(async () => response([usuario({ tipo: 'FINANCEIRO' })]), () =>
+    emailAuth.validar({ body: { login: 'financeiro-ficticio', senha: 'senha-ficticia' } })
+  );
+  assert.equal(resultado.usuario.id, 'u-1');
+});
+
+test('validar rejeita senha incorreta', async () => {
+  env();
+  await withFetch(async () => response([usuario()]), async () => {
+    await assert.rejects(
+      () => emailAuth.validar({ body: { login: 'financeiro-ficticio', senha: 'senha-errada' } }),
+      (err) => err.status === 401
+    );
+  });
+});
+
+test('validar rejeita usuário inativo', async () => {
+  env();
+  await withFetch(async () => response([usuario({ ativo: false })]), async () => {
+    await assert.rejects(
+      () => emailAuth.validar({ body: { login: 'financeiro-ficticio', senha: 'senha-ficticia' } }),
+      (err) => err.status === 401
+    );
+  });
+});
+
+test('validar rejeita papel não permitido', async () => {
+  env();
+  await withFetch(async () => response([usuario({ tipo: 'vendedora_rastreio' })]), async () => {
+    await assert.rejects(
+      () => emailAuth.validar({ body: { login: 'financeiro-ficticio', senha: 'senha-ficticia' } }),
+      (err) => err.status === 401
+    );
+  });
+});
+
+test('validar rejeita quando o usuário não existe', async () => {
+  env();
+  await withFetch(async () => response([]), async () => {
+    await assert.rejects(
+      () => emailAuth.validar({ body: { login: 'inexistente', senha: 'senha-ficticia' } }),
+      (err) => err.status === 401
+    );
+  });
+});
+
+test('validar devolve 503 quando o Supabase responde erro', async () => {
+  env();
+  await withFetch(async () => response({ message: 'indisponível' }, 500), async () => {
+    await assert.rejects(
+      () => emailAuth.validar({ body: { login: 'financeiro-ficticio', senha: 'senha-ficticia' } }),
+      (err) => err.status === 503
+    );
+  });
+});
diff --git a/tests/unit/rodonaves.test.js b/tests/unit/rodonaves.test.js
new file mode 100644
index 0000000..f91f49e
--- /dev/null
+++ b/tests/unit/rodonaves.test.js
@@ -0,0 +1,61 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+
+const { preserveEnv, resetEnv, restoreEnv } = require('../helpers/env');
+const tracking = require('../../lib/integracoes/_rodonaves-tracking');
+const fixture = require('../fixtures/rodonaves-tracking.json');
+
+preserveEnv();
+test.beforeEach(() => resetEnv());
+test.after(() => restoreEnv());
+
+test('mapearStatusRastreio traduz os rótulos da Rodonaves', () => {
+  assert.equal(tracking.mapearStatusRastreio('Entregue ao destinatário'), 'entregue');
+  assert.equal(tracking.mapearStatusRastreio('Saiu para entrega'), 'saiu_entrega');
+  assert.equal(tracking.mapearStatusRastreio('Em rota de entrega'), 'saiu_entrega');
+  assert.equal(tracking.mapearStatusRastreio('Avaria na carga'), 'ocorrencia');
+  assert.equal(tracking.mapearStatusRastreio('Entrega atrasada'), 'atrasado');
+  assert.equal(tracking.mapearStatusRastreio('Cancelado pelo cliente'), 'cancelado');
+  assert.equal(tracking.mapearStatusRastreio('Na filial de destino'), 'na_filial');
+  assert.equal(tracking.mapearStatusRastreio('Em trânsito'), 'em_transito');
+  assert.equal(tracking.mapearStatusRastreio('Aguardando coleta'), 'aguardando_coleta');
+  assert.equal(tracking.mapearStatusRastreio(''), 'em_transito');
+});
+
+test('extrairEventosRastreio lê a lista de ocorrências', () => {
+  const eventos = tracking.extrairEventosRastreio(fixture);
+  assert.equal(eventos.length, 2);
+  assert.equal(eventos[0].titulo, 'EM TRANSITO');
+  assert.equal(eventos[1].titulo, 'SAIU PARA ENTREGA');
+  assert.equal(eventos[1].local, 'Sao Paulo / SP');
+  assert.equal(eventos[1].codigo, '20');
+});
+
+test('interpretarRastreio usa a última ocorrência e extrai identificadores', () => {
+  const r = tracking.interpretarRastreio(fixture);
+  assert.equal(r.status, 'saiu_entrega');
+  assert.match(r.statusBruto, /Saiu para entrega/);
+  assert.equal(r.eventos.length, 2);
+  assert.equal(r.numeroCte, 'CTE-0001');
+  assert.equal(r.protocolo, 'PROT-0001');
+  assert.equal(r.numeroNfe, '12345');
+  assert.equal(r.chaveNfe, '11223344556677889900112233445566778899001122');
+  assert.match(r.ultimaOcorrencia, /Saiu para entrega/);
+});
+
+test('interpretarRastreio assume trânsito quando não há ocorrências', () => {
+  const r = tracking.interpretarRastreio({});
+  assert.equal(r.status, 'em_transito');
+  assert.equal(r.statusBruto, 'Mercadoria em trânsito');
+  assert.deepEqual(r.eventos, []);
+});
+
+test('erroPermiteProximaTentativa só continua em erros recuperáveis', () => {
+  assert.equal(tracking.erroPermiteProximaTentativa({ httpStatus: 404 }), true);
+  assert.equal(tracking.erroPermiteProximaTentativa({ httpStatus: 204 }), true);
+  assert.equal(tracking.erroPermiteProximaTentativa({ message: 'registro_nao_localizado' }), true);
+  assert.equal(tracking.erroPermiteProximaTentativa({ httpStatus: 500 }), false);
+  assert.equal(tracking.erroPermiteProximaTentativa({ httpStatus: 401 }), false);
+});
diff --git a/tests/unit/ssw.test.js b/tests/unit/ssw.test.js
new file mode 100644
index 0000000..4a76263
--- /dev/null
+++ b/tests/unit/ssw.test.js
@@ -0,0 +1,187 @@
+'use strict';
+
+const fs = require('node:fs');
+const path = require('node:path');
+const test = require('node:test');
+const assert = require('node:assert/strict');
+
+const { preserveEnv, resetEnv, restoreEnv, setEnv } = require('../helpers/env');
+const { loadScript } = require('../helpers/sandbox');
+
+preserveEnv();
+
+const stubs = {
+  './_utils': { json() {}, exigirAdmin() { return true; }, supabaseRest: async () => [] },
+  './carregar-credenciais': { obterCredenciaisIntegracao: async () => ({}) }
+};
+
+const { context: cotar } = loadScript('lib/integracoes/cotar-ssw.js', { stubs });
+const { context: rastreio } = loadScript('lib/integracoes/consultar-rastreio-ssw.js', { stubs });
+const { context: coleta } = loadScript('lib/integracoes/agendar-coleta-ssw.js', { stubs });
+
+function fixture(nome) {
+  return fs.readFileSync(path.join(__dirname, '..', 'fixtures', nome), 'utf8');
+}
+
+test.beforeEach(() => resetEnv());
+test.after(() => restoreEnv());
+
+test('xmlEsc escapa os cinco caracteres reservados', () => {
+  assert.equal(cotar.xmlEsc(`a&b<c>d"e'f`), 'a&amp;b&lt;c&gt;d&quot;e&apos;f');
+});
+
+test('htmlDec reverte entidades XML', () => {
+  assert.equal(cotar.htmlDec('a&amp;b&lt;c&gt;d&quot;e&apos;f'), `a&b<c>d"e'f`);
+});
+
+test('tag extrai conteúdo com atributos e é case-insensitive', () => {
+  assert.equal(cotar.tag('<Erro tipo="x">-1</Erro>', 'erro'), '-1');
+  assert.equal(cotar.tag('<a><b>valor</b></a>', 'c'), '');
+});
+
+test('numero interpreta decimal brasileiro', () => {
+  assert.equal(cotar.numero('1.234,56'), 1234.56);
+  assert.equal(cotar.numero('10,5'), 10.5);
+  assert.equal(cotar.numero(''), 0);
+  assert.equal(cotar.numero('abc'), 0);
+});
+
+test('volumeM3 aceita metros e centímetros e multiplica pela quantidade', () => {
+  assert.equal(cotar.volumeM3('0,38 x 0,29 x 0,35'), 0.0386);
+  assert.equal(cotar.volumeM3('38x29x35'), 0.0386);
+  assert.equal(cotar.volumeM3('0,38 x 0,29 x 0,35', 2), 0.0771);
+  assert.equal(cotar.volumeM3('incompleto'), 0);
+});
+
+test('dimensoesMedidas converte centímetros para metros', () => {
+  const cm = cotar.dimensoesMedidas('38x29x35');
+  assert.equal(cm.comprimento, 0.38);
+  assert.equal(cm.largura, 0.29);
+  assert.equal(cm.altura, 0.35);
+  const vazio = cotar.dimensoesMedidas('');
+  assert.equal(vazio.comprimento, 0);
+  assert.equal(vazio.largura, 0);
+  assert.equal(vazio.altura, 0);
+});
+
+test('mesmaTransportadoraSSW não confunde ACCERT, TG e nomes genéricos', () => {
+  assert.equal(cotar.mesmaTransportadoraSSW('Rodonaves', 'Rodonaves Transportes'), true);
+  assert.equal(cotar.mesmaTransportadoraSSW('Transportes Silva', 'Transportadora Silva'), true);
+  assert.equal(cotar.mesmaTransportadoraSSW('ACCERT', 'TG Transportes'), false);
+  // TG e TGT são aliases da mesma transportadora na regra atual.
+  assert.equal(cotar.mesmaTransportadoraSSW('TG', 'TGT'), true);
+  assert.equal(cotar.mesmaTransportadoraSSW('Transportes', 'Logística'), false);
+});
+
+test('credenciaisVercelSSW mapeia ACCERT e TG pelas variáveis de ambiente', () => {
+  setEnv({
+    ACCERT_SSW_DOMINIO: 'ACC',
+    ACCERT_SSW_LOGIN: 'login-accert-ficticio',
+    ACCERT_SSW_SENHA: 'senha-accert-ficticia',
+    ACCERT_SSW_CODIGO_MERCADORIA: '9'
+  });
+  const accert = cotar.credenciaisVercelSSW('ACCERT Transportes');
+  assert.equal(accert.ssw_dominio, 'ACC');
+  assert.equal(accert.ssw_login, 'login-accert-ficticio');
+  assert.equal(accert.ssw_codigo_mercadoria, '9');
+
+  setEnv({
+    TG_SSW_DOMINIO: 'TGT',
+    TG_SSW_LOGIN: 'login-tg-ficticio',
+    TG_SSW_SENHA: 'senha-tg-ficticia'
+  });
+  const tg = cotar.credenciaisVercelSSW('TG Transportes');
+  assert.equal(tg.ssw_dominio, 'TGT');
+  assert.equal(tg.ssw_login, 'login-tg-ficticio');
+  assert.equal(Object.keys(cotar.credenciaisVercelSSW('Outra Transportadora')).length, 0);
+});
+
+test('interpretarRetornoSSW lê cotação de sucesso', () => {
+  const d = cotar.interpretarRetornoSSW(fixture('ssw-cotacao-ok.xml'));
+  assert.equal(d.erro, 0);
+  assert.equal(d.totalFrete, 123.45);
+  assert.equal(d.prazo, 3);
+  assert.match(d.mensagem, /sucesso/);
+});
+
+test('interpretarRetornoSSW lê retorno escapado com erro', () => {
+  const d = cotar.interpretarRetornoSSW(fixture('ssw-cotacao-erro.xml'));
+  assert.equal(d.erro, -1);
+  assert.equal(d.totalFrete, 0);
+  assert.match(d.mensagem, /CNPJ/);
+});
+
+test('interpretarRetornoSSW lança em faultstring', () => {
+  assert.throws(
+    () => cotar.interpretarRetornoSSW('<soap:Fault><faultstring>Falha fictícia</faultstring></soap:Fault>'),
+    /Falha fictícia/
+  );
+});
+
+test('soapEnvelope escapa valores e inclui ciffob', () => {
+  const xml = cotar.soapEnvelope('urn:teste', {
+    dominio: 'ABC', login: 'u', senha: 'p', cnpjPagador: '11222333000181',
+    cepOrigem: 74000000, cepDestino: 20000000, valorNF: 100,
+    quantidade: 1, peso: 1, volume: 1, mercadoria: 1, ciffob: 'C',
+    cnpjRemetente: '11222333000181', cnpjDestinatario: '99888777000166',
+    observacao: 'Teste & <xml>', trt: 'N', coletar: 'S',
+    entDificil: 'N', destContribuinte: 'N', qtdePares: 0,
+    altura: 0, comprimento: 0, largura: 0, fatorMultiplicador: 0
+  });
+  assert.match(xml, /<ciffob[^>]*>C<\/ciffob>/);
+  assert.match(xml, /Teste &amp; &lt;xml&gt;/);
+  assert.match(xml, /xmlns:urn="urn:teste"/);
+});
+
+test('statusPorTexto normaliza as ocorrências SSW em status internos', () => {
+  assert.equal(rastreio.statusPorTexto('Mercadoria entregue ao destinatário'), 'entregue');
+  assert.equal(rastreio.statusPorTexto('Saiu para entrega'), 'saiu_entrega');
+  assert.equal(rastreio.statusPorTexto('Em trânsito para a filial'), 'em_transito');
+  assert.equal(rastreio.statusPorTexto('Chegada na unidade de destino'), 'na_filial');
+  assert.equal(rastreio.statusPorTexto('Devolvido ao remetente'), 'cancelado');
+  assert.equal(rastreio.statusPorTexto('Avaria na embalagem'), 'ocorrencia');
+});
+
+test('parseDataSSW aceita ISO e valor inválido', () => {
+  assert.equal(rastreio.parseDataSSW('2024-01-05T10:00:00Z'), Date.parse('2024-01-05T10:00:00Z'));
+  assert.equal(rastreio.parseDataSSW('25/01/2024 14:30'), new Date(2024, 0, 25, 14, 30).getTime());
+  assert.equal(rastreio.parseDataSSW('não é data'), 0);
+  assert.equal(rastreio.parseDataSSW(''), 0);
+});
+
+test('F23 corrigido: data dd/mm/aaaa com dia <= 12 mantém o dia informado', () => {
+  assert.equal(rastreio.parseDataSSW('05/01/2024 14:30'), new Date(2024, 0, 5, 14, 30).getTime());
+  assert.equal(rastreio.parseDataSSW('05/01/2024'), new Date(2024, 0, 5).getTime());
+  assert.equal(rastreio.parseDataSSW('5/1/2024'), new Date(2024, 0, 5).getTime());
+  assert.equal(rastreio.parseDataSSW('31/12/2023 23:59:30'), new Date(2023, 11, 31, 23, 59, 30).getTime());
+});
+
+test('eventosTrackingSSW ordena ocorrências e eventoTrackingSSW usa a mais recente', () => {
+  const dados = {
+    tracking: [
+      { ocorrencia: 'EM TRANSITO', descricao: 'Em viagem', data_hora: '01/01/2024 10:00', cidade: 'Goiânia', filial: 'GO' },
+      { ocorrencia: 'ENTREGUE', descricao: 'Entregue ao destinatário', data_hora: '02/01/2024 11:00' }
+    ]
+  };
+  const eventos = rastreio.eventosTrackingSSW(dados);
+  assert.equal(eventos.length, 2);
+  assert.equal(eventos[0].titulo, 'EM TRANSITO');
+  assert.equal(eventos[1].titulo, 'ENTREGUE');
+  const ultimo = rastreio.eventoTrackingSSW(dados);
+  assert.equal(ultimo.titulo, 'ENTREGUE');
+  assert.equal(ultimo.totalEventos, 2);
+});
+
+test('helpers da coleta SSW normalizam documento e números', () => {
+  assert.equal(coleta.digits('12.345.678/0001-99'), '12345678000199');
+  assert.equal(coleta.num('1.234,56'), 1234.56);
+  assert.equal(coleta.num('10'), 10);
+  assert.equal(coleta.esc('a&b'), 'a&amp;b');
+  assert.equal(coleta.xmlDecode('a&amp;b'), 'a&b');
+  assert.equal(coleta.tag('<a><![CDATA[valor]]></a>', 'a'), 'valor');
+});
+
+test('mesmaTransportadoraSSW da coleta tem a mesma proteção de ACCERT/TG', () => {
+  assert.equal(coleta.mesmaTransportadoraSSW('ACCERT', 'TG Transportes'), false);
+  assert.equal(coleta.mesmaTransportadoraSSW('Rodonaves', 'Rodonaves Transportes'), true);
+});
diff --git a/tests/unit/utils.test.js b/tests/unit/utils.test.js
new file mode 100644
index 0000000..63cab6b
