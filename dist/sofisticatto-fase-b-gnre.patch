+  'GNRE_CERT_PASSWORD',
+  'GOOGLE_GMAIL_ADMIN_USER',
+  'GOOGLE_SERVICE_ACCOUNT_EMAIL',
+  'GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY',
+  'SMTP_HOST',
+  'SMTP_PORT',
+  'SMTP_SECURE',
+  'SMTP_USER',
+  'SMTP_PASS',
+  'SMTP_FROM',
+  'SMTP_FROM_EMAIL',
+  'SMTP_FROM_NAME',
+  'ENABLE_BRADESCO_BAIXA_REAL'
+];
+
+let snapshot = null;
+
+function preserveEnv() {
+  if (snapshot) return;
+  snapshot = { ...process.env };
+}
+
+function resetEnv() {
+  for (const key of MANAGED) delete process.env[key];
+}
+
+function restoreEnv() {
+  if (!snapshot) return;
+  for (const key of Object.keys(process.env)) delete process.env[key];
+  Object.assign(process.env, snapshot);
+  snapshot = null;
+}
+
+function setEnv(values) {
+  Object.assign(process.env, values);
+}
+
+module.exports = { MANAGED, preserveEnv, resetEnv, restoreEnv, setEnv };
diff --git a/tests/helpers/http.js b/tests/helpers/http.js
new file mode 100644
index 0000000..fc2197d
--- /dev/null
+++ b/tests/helpers/http.js
@@ -0,0 +1,61 @@
+'use strict';
+
+// Bloqueio de rede dos testes: qualquer URL não mockada lança erro.
+// Nenhuma chamada real a Correios, SSW, bancos, transportadoras ou Supabase.
+
+const realFetch = globalThis.fetch;
+
+function response(body, status = 200, headers = {}) {
+  const text = typeof body === 'string' ? body : JSON.stringify(body ?? null);
+  return {
+    ok: status >= 200 && status < 300,
+    status,
+    headers: new Headers(headers),
+    async text() { return text; },
+    async json() { return JSON.parse(text); },
+    async arrayBuffer() { return Buffer.from(text, 'utf8'); }
+  };
+}
+
+function blocked(url) {
+  throw new Error(`[TESTE] Chamada externa bloqueada: ${url}`);
+}
+
+// handler(url, init) deve devolver uma resposta. Se devolver undefined,
+// a chamada é considerada externa e falha imediatamente.
+async function withFetch(handler, fn) {
+  globalThis.fetch = async (input, init = {}) => {
+    const url = typeof input === 'string' ? input : String(input?.url || input);
+    const mocked = await handler(url, init);
+    if (mocked === undefined) blocked(url);
+    return mocked;
+  };
+  try {
+    return await fn();
+  } finally {
+    globalThis.fetch = realFetch;
+  }
+}
+
+// Fila de respostas: cada requisição consome o próximo item.
+function withFetchQueue(items, fn) {
+  let index = 0;
+  const calls = [];
+  return withFetch(async (url, init) => {
+    calls.push({ url, init });
+    if (index >= items.length) return undefined;
+    const item = items[index++];
+    if (typeof item === 'function') return item(url, init);
+    return item;
+  }, async () => {
+    const result = await fn(calls);
+    return result;
+  }).finally(() => { index = 0; });
+}
+
+// Garante que nenhuma chamada de rede acontece em um bloco de teste.
+async function withNoNetwork(fn) {
+  return withFetch(async () => undefined, fn);
+}
+
+module.exports = { response, withFetch, withFetchQueue, withNoNetwork };
diff --git a/tests/helpers/module-stubs.js b/tests/helpers/module-stubs.js
new file mode 100644
index 0000000..5ed13a2
--- /dev/null
+++ b/tests/helpers/module-stubs.js
@@ -0,0 +1,46 @@
+'use strict';
+
+const Module = require('node:module');
+
+// Substitui módulos externos apenas durante o require. Usado para carregar
+// api/integracoes.js sem instalar node-forge/google-auth-library e sem
+// qualquer acesso de rede.
+function withModuleStubs(stubs, fn) {
+  const original = Module._load;
+  Module._load = function patchedLoad(request, parent, isMain) {
+    if (Object.prototype.hasOwnProperty.call(stubs, request)) return stubs[request];
+    return original.apply(this, arguments);
+  };
+  try {
+    return fn();
+  } finally {
+    Module._load = original;
+  }
+}
+
+// Response e Request mínimos para testar handlers serverless sem Express.
+function fakeResponse() {
+  return {
+    statusCode: 200,
+    body: null,
+    headers: {},
+    headersSent: false,
+    setHeader(name, value) { this.headers[String(name).toLowerCase()] = value; },
+    getHeader(name) { return this.headers[String(name).toLowerCase()]; },
+    status(code) { this.statusCode = code; return this; },
+    json(payload) { this.body = payload; return this; },
+    send(payload) { this.body = payload; return this; }
+  };
+}
+
+function fakeRequest(overrides = {}) {
+  return {
+    method: 'POST',
+    query: {},
+    body: {},
+    headers: {},
+    ...overrides
+  };
+}
+
+module.exports = { withModuleStubs, fakeResponse, fakeRequest };
diff --git a/tests/helpers/no-network.js b/tests/helpers/no-network.js
new file mode 100644
index 0000000..47b25f3
--- /dev/null
+++ b/tests/helpers/no-network.js
@@ -0,0 +1,21 @@
+'use strict';
+
+// Carregado via --require em todos os scripts de teste.
+// Garante que nenhum teste faça chamada real, mesmo que uma função de
+// produção tente usar fetch/http/https diretamente.
+
+globalThis.fetch = async (input) => {
+  const url = typeof input === 'string' ? input : String(input?.url || input);
+  throw new Error(`[TESTE] Rede externa bloqueada: ${url}`);
+};
+
+const http = require('node:http');
+const https = require('node:https');
+
+for (const modulo of [http, https]) {
+  const bloquear = () => {
+    throw new Error('[TESTE] Requisição HTTP externa bloqueada.');
+  };
+  modulo.request = bloquear;
+  modulo.get = bloquear;
+}
